# Axioma - Konfiguracja zmiennych środowiskowych .env.example

# Podstawowa konfiguracja aplikacji Flask
FLASK_APP=run.py
FLASK_DEBUG=1
FLASK_CONFIG=development

# Bezpieczeństwo sesji i tokenów CSRF
SECRET_KEY=klucz-sesji-min-32-znaki

# Opcjonalny stały adres bazowy domeny
APP_BASE_URL=

# Magazyn dla limitera zapytań Rate Limiting
RATELIMIT_STORAGE_URI=memory://

# Baza danych
DATABASE_URL=sqlite:///app.db

# Integracja ze sztuczną inteligencją
# Dedykowany model: Google Gemini 3.8 Flash
GEMINI_API_KEY=klucz_z_google_ai_studio
GEMINI_MODEL=gemini-3.8-flash

# Zaawansowane nagłówki bezpieczeństwa sieciowego i Reverse Proxy
USE_PROXY_FIX=true
FORCE_HSTS=false
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=0
PROXY_FIX_X_PREFIX=1


# Konfiguracja wysyłki wiadomości e-mail - Resetowanie hasła

# W przypadku braku konfiguracji, linki resetujące są logowane do konsoli serwera.
#
# PRZYKŁAD DLA GMAIL:
#   MAIL_SERVER=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USE_TLS=true
#   MAIL_USE_SSL=false
#   MAIL_USERNAME=adres@gmail.com
#   MAIL_PASSWORD=16-znakowe-haslo-aplikacji
#   MAIL_DEFAULT_SENDER=adres@gmail.com
#   MAIL_SENDER_NAME=Axioma - Platforma Edukacyjna
#
# PRZYKŁAD DLA INTERIA / ONET / WP:
#   MAIL_SERVER=poczta.interia.pl
#   MAIL_PORT=587
#   MAIL_USE_TLS=true
#   MAIL_USE_SSL=false
#   MAIL_USERNAME=konto@interia.pl
#   MAIL_PASSWORD=haslo-do-konta
#
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_SENDER_NAME=Axioma - Platforma Edukacyjna
